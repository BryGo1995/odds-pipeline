{
  "name": "odds-pipeline dev",
  "dockerComposeFile": ["../docker-compose.dev.yml", "docker-compose.devcontainer.yml"],
  "initializeCommand": "docker compose -f docker-compose.dev.yml build dev",
  "service": "dev",
  "workspaceFolder": "/workspace",
  "overrideCommand": false,
  "shutdownAction": "none",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"],
      "settings": {
        "python.defaultInterpreterPath": "/home/airflow/.local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["nba/tests/unit", "shared/tests"]
      }
    }
  }
}
